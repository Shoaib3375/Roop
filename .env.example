# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# HTTPS endpoint that receives validated booking enquiry JSON.
# Configure the actual secret URL in .env.local or your hosting provider settings.
ROOP_ENQUIRY_WEBHOOK=https://your-webhook-provider.example/roop-enquiries